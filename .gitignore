# ---------- 虚拟环境 ----------
.venv/

# ---------- 运行数据（数据库/缩略图/模型，可由脚本重建或下载） ----------
data/
!data/.gitkeep

# ---------- 本机个人配置（含本机摄像头盘符路径，不入库） ----------
config.json
config.json.bak
config_*Conflict*.json
*.corrupt-*

# ---------- 工具私有数据 ----------
.workbuddy/

# ---------- Python 缓存 ----------
__pycache__/
*.py[cod]
*.egg-info/

# ---------- 备份 / 临时文件 ----------
*.zip
*.tmp
*.log

# 个人内容草稿（不入库）
docs/宗文奇阁坊-监控录像逆向抢救.md
